---
import Base from '../layouts/Base.astro';
import {articles,categories} from '../data/articles.js';
const [lead,...rest]=articles;
---
<Base><main class="wrap"><div class="issue"><span>NUMMER 001 / EFTERÅR 2026</span><span>LITTERATUR · KULTUR · TÆNKNING</span></div><section class="hero"><a href={'/artikler/'+lead.slug} class="hero-image"><img src={lead.image} alt="Stemningsfuld nattehimmel"/></a><div class="hero-copy"><span class="pill">I fokus / {lead.category}</span><h1 class="article-title"><a href={'/artikler/'+lead.slug}>{lead.title}</a></h1><p class="hero-sub">{lead.subtitle}</p><div class="byline">Af {lead.author} <span>—</span> {lead.read} læsning</div><a class="readlink" href={'/artikler/'+lead.slug}>Læs fortællingen <span>↗</span></a></div></section><div class="intro"><span class="eyebrow">Litteraturen begynder her</span><p class="serif">Vi læser for at forstå verden. Og for at opdage, hvor meget vi endnu ikke forstår.</p></div><section id="artikler" class="section"><div class="rule-title"><h2>Seneste historier</h2><span class="eyebrow muted">Fra redaktionen</span></div><div class="filter"><label for="search" class="sr">Søg i artikler</label><input id="search" type="search" placeholder="Søg i artikler og forfattere …"/><div class="chips">{categories.map((cat,i)=><button class:list={['chip',{'active':i===0}]} data-filter={cat}>{cat}</button>)}</div></div><div class="cards" id="cards">{rest.map(a=><a href={'/artikler/'+a.slug} class="article-card" data-category={a.category} data-search={(a.title+' '+a.subtitle+' '+a.category).toLowerCase()}><img src={a.image} alt="Litterært stemningsfoto" loading="lazy"/><span class="pill">{a.category}</span><h3 class="article-title">{a.title}</h3><p>{a.subtitle}</p><small>{a.date} · {a.read}</small></a>)}</div><p id="empty" hidden>Ingen artikler matcher din søgning.</p></section><section class="quote" id="bogreolen"><div><span class="eyebrow">Bogreolen</span><h2 class="serif">Hvilken bog skal du læse som den næste?</h2><p>Fra glemte klassikere til nye litterære stemmer. Gå på opdagelse i vores anbefalinger.</p><a class="btn" href="/artikler/hvorfor-laese-klassikere">Gå til bogreolen ↗</a></div><div class="quote-mark">“</div></section></main><script>const search=document.querySelector('#search');const chips=[...document.querySelectorAll('.chip')];const cards=[...document.querySelectorAll('.article-card')];let selected='Alle';function filter(){const q=search.value.trim().toLowerCase();let count=0;cards.forEach(c=>{const ok=(selected==='Alle'||c.dataset.category===selected)&&c.dataset.search.includes(q);c.hidden=!ok;if(ok)count++});document.querySelector('#empty').hidden=count>0}search.addEventListener('input',filter);chips.forEach(c=>c.addEventListener('click',()=>{selected=c.dataset.filter;chips.forEach(x=>x.classList.toggle('active',x===c));filter()}));</script><style>.issue{display:flex;justify-content:space-between;margin:24px 0;font-size:10px;letter-spacing:.15em;color:var(--muted);font-weight:700}.hero{display:grid;grid-template-columns:1.24fr 1fr;min-height:475px;border-bottom:1px solid var(--line);padding-bottom:40px;gap:50px}.hero-image img{height:100%;max-height:490px;min-height:380px}.hero-copy{display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.hero h1{font-size:clamp(60px,6.6vw,105px);margin:20px 0}.hero-sub{font-family:Georgia,serif;font-size:21px;line-height:1.55;color:#4d5a51}.byline{font-size:12px;color:var(--muted);margin-top:18px}.byline span{padding:0 9px}.readlink{border-bottom:1px solid var(--ink);margin-top:45px;padding-bottom:10px;text-transform:uppercase;font-size:12px;letter-spacing:.1em;font-weight:700;min-width:220px;display:flex;justify-content:space-between}.intro{text-align:center;max-width:820px;margin:85px auto 100px}.intro p{font-size:clamp(30px,4.1vw,55px);line-height:1.22;margin:20px 0}.section{margin-bottom:110px}.filter{margin-bottom:35px;display:flex;gap:20px;align-items:center;justify-content:space-between;flex-wrap:wrap}.filter input{background:transparent;border:0;border-bottom:1px solid var(--line);padding:12px 3px;min-width:240px;outline:none}.filter input:focus{border-color:var(--ink)}.chips{display:flex;gap:8px;flex-wrap:wrap}.chip{border:1px solid var(--line);background:transparent;padding:9px 13px;cursor:pointer;font-size:11px}.chip.active,.chip:hover{background:var(--ink);color:white}.cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:45px 25px}.article-card img{height:220px;margin-bottom:22px}.article-card .article-title{font-size:36px;margin:12px 0}.article-card p{font-family:Georgia,serif;line-height:1.6;color:#566159;font-size:16px}.article-card small{font-size:11px;color:var(--muted)}.article-card[hidden]{display:none}.quote{border-top:1px solid var(--ink);padding:50px 0 20px;display:flex;justify-content:space-between;gap:30px}.quote>div:first-child{max-width:670px}.quote h2{font-size:clamp(40px,5vw,72px);line-height:1.1;margin:20px 0}.quote p{color:var(--muted);line-height:1.7;margin-bottom:25px}.quote-mark{font-family:Georgia,serif;font-size:290px;line-height:.7;color:#b5bcae}.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(max-width:850px){.hero{grid-template-columns:1fr;gap:25px}.hero-image img{height:330px;min-height:0}.hero h1{font-size:70px}.cards{grid-template-columns:repeat(2,1fr)}.quote-mark{display:none}}@media(max-width:560px){.issue span:last-child{display:none}.hero h1{font-size:59px}.cards{grid-template-columns:1fr}.article-card img{height:260px}.intro{margin:65px auto}.section{margin-bottom:65px}}</style></Base>
