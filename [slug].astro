---
import Base from '../../layouts/Base.astro';
import {articles} from '../../data/articles.js';
export function getStaticPaths(){return articles.map(article=>({params:{slug:article.slug},props:{article}}));}
const {article}=Astro.props;
---
<Base title={article.title+' | Mellem Linjerne'} description={article.subtitle}><main class="wrap"><article class="story"><a href="/" class="back">← Tilbage til magasinet</a><div class="pill">{article.category}</div><h1 class="serif">{article.title}</h1><p class="dek">{article.subtitle}</p><div class="meta">Af {article.author} · {article.date} · {article.read} læsning</div><img src={article.image} alt="Stemningsfoto til artiklen"/><div class="body">{article.body.map(p=><p>{p}</p>)}</div><div class="note">Redaktionel note: Dette er en demotekst til magasinets prototype. Teksten skal gennemgås og udbygges før offentlig lancering.</div><a href="/" class="back">← Flere historier</a></article></main><style>.story{max-width:920px;margin:40px auto 100px}.back{display:inline-block;margin:0 0 55px;font-size:12px;letter-spacing:.1em;text-transform:uppercase;border-bottom:1px solid var(--ink);padding-bottom:7px}.story h1{font-size:clamp(60px,9vw,116px);line-height:1.03;margin:18px 0}.dek{font-family:Georgia,serif;font-size:clamp(22px,3vw,30px);line-height:1.45;max-width:750px;color:#55645a}.meta{font-size:12px;color:var(--muted);margin:35px 0}.story img{height:480px}.body{max-width:670px;margin:60px auto;font-family:Georgia,serif;font-size:22px;line-height:1.85}.body p:first-child:first-letter{float:left;font-size:84px;line-height:.9;padding-right:9px;color:var(--wine)}.note{max-width:670px;margin:0 auto 50px;padding:20px;border-top:1px solid var(--line);font-size:12px;color:var(--muted);line-height:1.6}@media(max-width:650px){.story img{height:260px}.body{font-size:19px}.back{margin-bottom:35px}}</style></Base>
